# Fundmf API - local development environment.
# Copy to `.env` and fill in. Never commit the real `.env`.

# HTTP
PORT=8080
# Comma separated list of browser origins allowed to call the API.
# Use * for development, then the real web origin in production.
ALLOWED_ORIGINS=*

# Firebase Admin (Authentication + Firestore stay in Firebase).
# Paste the full service account JSON on one line, or leave it empty and use
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# The single account allowed to trigger the CAMS sync.
ADMIN_EMAIL=fundmfservices@gmail.com

# How many unread CAMS emails one run may scan (default 25).
CAMS_MAX_MESSAGES=25

# Password of the zip that carries the CAMS CSV statements.
CAMS_ZIP_PASSWORD=Fund@123

# Gmail OAuth2 for fundmfservices@gmail.com (scope gmail.modify).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
