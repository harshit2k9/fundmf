# Fundmf API (Express on Render). Same backend the Flutter app calls.
VITE_API_BASE_URL=https://fundmf.onrender.com

# Where the Android APK is served from. Defaults to /fundmf-release.apk, which
# is what `npm run copy-apk` places into public/. Point it at a GitHub release
# asset or a CDN URL instead if you prefer not to ship the binary with the site.
# VITE_APK_URL=https://example.com/fundmf-release.apk
